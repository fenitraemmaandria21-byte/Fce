# --- PostgreSQL (Docker) ---
POSTGRES_DB=fce_si
POSTGRES_USER=fce
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql://fce:change_me@localhost:5432/fce_si
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
PORT=4000
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_DOCKER=http://localhost:8888
NODE_ENV=development

# --- Amorçage (création du premier superadmin) ---
# Secret exigé par POST /api/auth/bootstrap. Laisser vide pour désactiver.
BOOTSTRAP_SECRET=change_me_with_a_random_secret

# --- Frontend ---
VITE_API_URL=http://localhost:4000/api

